{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "importId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "importType": {
      "type": "string",
      "const": "recipes"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "payload": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "portions": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "ingredients": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "g",
                    "ml",
                    "ks"
                  ]
                }
              },
              "required": [
                "name",
                "quantity",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "steps": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "reheating": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "storage": {
            "default": "Rýchlo schlaďte. Rozmrazujte v chladničke a dôkladne prehrejte.",
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "meat": {
            "default": "none",
            "type": "string",
            "enum": [
              "none",
              "beef",
              "pork",
              "chicken",
              "other",
              "fish"
            ]
          },
          "freezing": {
            "default": true,
            "type": "boolean"
          },
          "imageReferences": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "sourceUrl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "author": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "license": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "sourceUrl",
                "alt",
                "author",
                "license"
              ]
            }
          },
          "category": {
            "enum": [
              "general",
              "slow_roasted_pulled_meat"
            ]
          },
          "cooking_method": {
            "enum": [
              "oven",
              "stove",
              "slow_roast"
            ]
          },
          "prep_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "cooking_minutes_min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2880
          },
          "cooking_minutes_max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2880
          },
          "oven_c": {
            "type": "integer",
            "minimum": 50,
            "maximum": 300
          },
          "meal_role": {
            "type": "string",
            "enum": [
              "unknown",
              "main",
              "complete",
              "side",
              "vegetable_side",
              "component",
              "breakfast",
              "snack"
            ]
          },
          "allowed_slots": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "breakfast",
                "lunch",
                "dinner",
                "snack"
              ]
            },
            "maxItems": 4,
            "uniqueItems": true
          },
          "side_policy": {
            "type": "string",
            "enum": [
              "none",
              "optional",
              "required"
            ]
          },
          "compatible_side_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 30,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "portions",
          "ingredients",
          "steps",
          "reheating",
          "storage",
          "meat",
          "freezing"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "importId",
    "importType",
    "source",
    "generatedAt",
    "payload"
  ],
  "additionalProperties": false
}
